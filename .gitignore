chrome-profile/
chrome-automation/
user-data/
profile/

# ─── runtime artifacts ──────────────────────────────────────────────
*.log
results/
state/
screenshots/
shots/
.posted.json

# ─── node ───────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
