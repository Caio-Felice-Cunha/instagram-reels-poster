# Copy this file to ".env" and fill in YOUR values. ".env" is gitignored.

# Where the video files referenced by your manifest live.
VIDEOS_DIR=videos

# The CDP endpoint of the Chrome you launched with --remote-debugging-port.
DEBUG_PORT=9222
# CDP_URL=http://localhost:9222

# Optional default location tag applied to every post when a manifest entry
# does not specify its own. Leave blank for no location.
# DEFAULT_LOCATION=

# Minutes between posts in a batch run (a small random jitter is added).
# Instagram restricts accounts that post many times in quick succession, so
# keep this generous. See the README "Pacing" note.
BATCH_SPACING_MINUTES=3
