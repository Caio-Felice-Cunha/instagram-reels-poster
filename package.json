{
  "name": "instagram-reels-poster",
  "version": "1.0.0",
  "description": "Post Reels to Instagram by driving instagram.com in your own logged-in Chrome over the DevTools Protocol. No Graph API, no OS file dialog.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "post": "node src/post.mjs",
    "batch": "node src/batch.mjs",
    "connect-check": "node src/connect-check.mjs",
    "demo": "node src/demo.mjs --fixture manifest.example.json --output site",
    "test": "node --test tests/*.test.mjs",
    "test:site": "playwright test",
    "test:all": "npm run demo && npm test && npm run test:site"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "http-server": "14.1.1"
  },
  "keywords": [
    "instagram",
    "reels",
    "automation",
    "playwright",
    "cdp",
    "social-media"
  ]
}
